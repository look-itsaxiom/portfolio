# OpenRouter (required for Ask Axiom chat generation)
OPENROUTER_API_KEY=
# Model used by /api/chat
CHAT_MODEL=google/gemini-2.5-flash
# Model used by /api/discord-callback personality rewrite
OPENROUTER_MODEL=google/gemini-2.5-flash

# Embeddings — local Ollama on the shared `edge` network (see homelab/ollama)
OLLAMA_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text

# Discord Bot (required for fallback flow)
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Optional overrides
QDRANT_COLLECTION=ask-axiom-knowledge

# Admin Dashboard
ADMIN_SECRET=

# Revalidation (shared between web and admin for on-demand cache busting)
REVALIDATE_SECRET=
